# 手机版（Termux）配置。改完不需要重启 Termux，下一次 phone/start.sh 生效。
# 使用时复制到 phone/kit.env：cp phone/kit.env.example phone/kit.env

# proot-distro 的发行版别名，默认 debian
# PD_DISTRO=debian

# 容器内数据目录（一般不用改；改了要同步改 phone/proot.sh）
# WX_HOME=/root/wx

# 虚拟屏编号，默认 :99
# WX_DISPLAY=:99

# 记忆镜像目标（要开启 features.memory_mirror 才生效）
# WX_MIRROR=/sdcard/phone-ai-memory
